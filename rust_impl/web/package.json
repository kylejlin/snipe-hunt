{
  "name": "snipe-hunt-web",
  "private": true,
  "version": "0.49.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../crates/snipe-wasm --target web --out-dir ../../web/src/wasm/pkg --release",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc -b && vite build",
    "build:github-pages": "npm run build:wasm && tsc -b && vite build --base=/snipe-hunt/",
    "deploy": "node scripts/deploy-github-pages.mjs",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.1",
    "typescript": "~5.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
